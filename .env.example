# ============================================================
# NeuraSite AI + NeuraLead Bot — переменные окружения
# ============================================================

# --- POLZA AI (для генератора сайтов) - ОСНОВНОЙ ---
# Получить: https://polza.ai/register -> API Keys
POLZA_API_KEY=sk-polza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLZA_BASE_URL=https://polza.ai/api/v1

# Модели по умолчанию (можно переопределить)
POLZA_TEXT_MODEL=anthropic/claude-sonnet-5.5
POLZA_IMAGE_MODEL=bytedance/seedream-4.5

# --- ДЕМО-БОТ «Наш дом. Медиа» × NeuraLead (run_bots.py) ---
# Telegram: токен от @BotFather. Если пусто — Telegram-бот не запускается.
BOT_TOKEN=
# Ваш Telegram ID: сюда приходят заявки, команда /leads
ADMIN_CHAT_ID=
# MAX: токен бота из кабинета MAX для партнёров. Если пусто — MAX-бот не запускается.
MAX_BOT_TOKEN=
# Ваш ID в MAX (необязательно; иначе заявки из MAX тоже идут в Telegram)
MAX_ADMIN_USER_ID=
# Модели Polza: первая основная, остальные запасные
LLM_MODELS=google/gemini-2.5-flash,deepseek/deepseek-v4.1-flash,anthropic/claude-haiku-5.5
# Папка для базы заявок и переписки — на хостинге сделайте её постоянной (volume)
DATA_DIR=data

# --- YandexGPT (опционально, страховка) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# --- GigaChat (опционально) ---
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat

# --- ДЕПЛОЙ ---
WEBHOOK_URL=
PORT=8000
