# ============================================================
# NeuraSite AI + NeuraLead Bot — переменные окружения
# ============================================================

# --- POLZA AI (для генератора сайтов) - ОСНОВНОЙ ---
# Получить: https://polza.ai/register -> API Keys
POLZA_API_KEY=sk-polza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLZA_BASE_URL=https://polza.ai/api/v1

# Модели по умолчанию (можно переопределить)
POLZA_TEXT_MODEL=anthropic/claude-sonnet-4-5
POLZA_IMAGE_MODEL=bytedance/seedream-4.5

# --- TELEGRAM BOT (старый функционал) ---
BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-xxxxxxxxx
ADMIN_CHAT_ID=123456789

# --- LLM: OpenRouter / Polza (совместимость) ---
# Можно использовать POLZA_API_KEY как DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODELS=anthropic/claude-sonnet-4-5,openai/gpt-5,google/gemini-2.5-pro,deepseek/deepseek-v3.2
LLM_BASE_URL=https://polza.ai/api/v1

# --- YandexGPT (опционально, страховка) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# --- GigaChat (опционально) ---
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat

# --- ДЕПЛОЙ ---
WEBHOOK_URL=
PORT=8000
